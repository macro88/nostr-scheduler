{
  "name": "nostr-scheduler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "nostr-scheduler": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "custody:check": "node scripts/custody-check.mjs",
    "demo:harness": "NOSTR_SCHEDULER_MODE=demo node src/demo/harness.ts",
    "demo:local": "NOSTR_SCHEDULER_MODE=demo node src/demo/local.ts",
    "relay:local": "node src/test-relay/stand.ts",
    "criteria:validate": "node src/cli/main.ts criteria validate",
    "start": "node src/cli/main.ts",
    "ui": "vite build --config web/vite.config.ts && node src/http/serve.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@macro88/theme-nostr": "https://github.com/macro88/design-system/releases/download/v0.1.0/macro88-theme-nostr-0.1.0.tgz",
    "@macro88/ui": "https://github.com/macro88/design-system/releases/download/v0.1.0/macro88-ui-0.1.0.tgz",
    "@hono/node-server": "^2.1.6",
    "@napi-rs/keyring": "^2.1.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.4.0",
    "hono": "^4.13.17",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.1",
    "lucide-react": "^1.71.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.7",
    "vitest": "^4.0.8"
  }
}
